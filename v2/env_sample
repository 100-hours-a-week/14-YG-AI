# .env.example
# 이 파일을 .env로 복사하고 실제 값들로 수정하세요

# ===== 환경 설정 =====
ENVIRONMENT=development

# ===== 데이터베이스 설정 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=jeongtaek
DB_PASSWORD=postgres
DB_DBNAME=test

# ===== Google Cloud 설정 =====
GOOGLE_PROJECT=deft-observer-456807-c5
GOOGLE_LOCATION=us-central1
GOOGLE_CREDENTIALS_PATH=deft-observer-456807-c5-e9dda0532301.json
GOOGLE_MODEL_NAME=gemini-2.0-flash
GOOGLE_TEMPERATURE=0.7

# ===== Upstage API 설정 =====
UPSTAGE_API_KEY=your_upstage_api_key_here
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_EMBEDDING_MODEL=embedding-query

# ===== Langfuse 설정 =====
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 서버 설정 =====
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_DEBUG=true
SERVER_SESSION_TIMEOUT_MINUTES=60
SERVER_MAX_SESSIONS=1000
SERVER_MAX_MESSAGE_LENGTH=5000
SERVER_MAX_HISTORY_PER_SESSION=100

# ===== 워크플로우 설정 =====
WORKFLOW_DEFAULT_AGENT_TEMPERATURE=0.2
WORKFLOW_SUPERVISOR_TEMPERATURE=0.1
WORKFLOW_DEFAULT_SEARCH_LIMIT=5
WORKFLOW_MAX_SEARCH_LIMIT=20
WORKFLOW_APPROVAL_TIMEOUT_MINUTES=30
WORKFLOW_MAX_PENDING_APPROVALS=100

# ===== 로깅 설정 =====
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE_PATH=logs/chatbot.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_LANGCHAIN_LOG_LEVEL=WARNING
LOG_GOOGLE_LOG_LEVEL=WARNING